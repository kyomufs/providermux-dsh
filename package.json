{
  "name": "providermux-dsh",
  "description": "Free AI providers for DeepSeek Harness, through a local providermux daemon. Every provider the daemon serves appears as its own route.",
  "version": "1.1.3",
  "type": "commonjs",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node test/smoke.cjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kyomufs/providermux-dsh.git"
  },
  "homepage": "https://github.com/kyomufs/providermux-dsh",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "providermux",
    "free-models",
    "llm",
    "provider",
    "aggregator",
    "multi-provider"
  ]
}
